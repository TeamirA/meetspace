# ── Database (Supabase Postgres via Supavisor) ───────────────────────────────
# Runtime: transaction pooler (port 6543). Migrations: session pooler (port 5432).
DATABASE_URL="postgresql://meetspace_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://meetspace_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ── App auth (generate each with: openssl rand -base64 48) ───────────────────
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# HMAC key used to derive unguessable Realtime room topics
ROOM_TOPIC_SECRET=""

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server only. Dashboard → Project Settings → API Keys → service_role (or a secret key)
SUPABASE_SERVICE_ROLE_KEY=""
# Server only. Dashboard → Project Settings → JWT Keys → Legacy JWT secret.
# Used to sign short-lived Realtime room tokens checked by RLS on realtime.messages.
SUPABASE_JWT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── TURN (optional; STUN-only when unset) ────────────────────────────────────
# Metered.ca
METERED_APP_NAME=""
METERED_SECRET_KEY=""
# or Cloudflare Realtime TURN
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# ── Tests ────────────────────────────────────────────────────────────────────
# Integration tests run against an isolated schema, e.g. ...postgres?schema=test
TEST_DATABASE_URL=""
